<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LudoClient.ControlView.Capsule">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Grid VerticalOptions="Start" HorizontalOptions="Center">

                <Image Source="{TemplateBinding ImageSource}" 
                       x:Name="ImageSourceContainer" 
                       VerticalOptions="Start" 
                       HorizontalOptions="Center"/>

                <Grid x:Name="OverlayGrid" 
                      VerticalOptions="Start" 
                      HorizontalOptions="Center" >
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalOptions="Fill" HorizontalOptions="Fill"/>
                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>