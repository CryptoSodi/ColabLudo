<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LudoClient.ControlView.ChatCard"
             xmlns:local="clr-namespace:LudoClient.ControlView" Padding="5">
    <Grid>
        <Frame x:Name="LayerFrame" Padding="5" CornerRadius="8" HasShadow="True" BackgroundColor="LightGray" HorizontalOptions="Start" MaximumWidthRequest="250">
            <!-- limit bubble width -->
            <StackLayout Spacing="2">
                <Label x:Name="MessageText"
                       Text="This is a sample chat bubble message."
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Justify"
                       FontSize="14"
                       TextColor="White"/>
                <Label x:Name="TimeText"
                       Text="12:14 AM"
                       FontSize="10"
                       TextColor="LightGray"
                       HorizontalOptions="End"/>
            </StackLayout>
        </Frame>
    </Grid>
</ContentView>