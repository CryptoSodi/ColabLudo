<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Container centered on screen, mirroring Settings Gold Standard -->
	<androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <!-- Background Image defining the popup size -->
        <ImageView
            android:id="@+id/popupBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/support_popup_bg"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" 
            android:translationY="17dp"
            android:layout_marginBottom="17dp"/>

        <!-- Proportion Guidelines based on .8*, .2*, 2*, 3*, 1*, .6* (Total 7.6) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.105" /> <!-- .8/7.6 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.131" /> <!-- (.8+.2)/7.6 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.394" /> <!-- (1+2)/7.6 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.789" /> <!-- (3+3)/7.6 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.921" /> <!-- (6+1)/7.6 -->

        <!-- Title Bar - 3/4 width, centered, with negative translation -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:translationY="1dp"
            app:layout_constraintWidth_percent="0.75"
            app:layout_constraintTop_toTopOf="@id/popupBg"
            app:layout_constraintStart_toStartOf="@id/popupBg"
            app:layout_constraintEnd_toEndOf="@id/popupBg">
            
            <ImageView
                android:id="@+id/titleImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/popup_title"
                android:adjustViewBounds="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
                
            <TextView
                android:id="@+id/titleText"
                android:translationY="-8dp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="Daily Bonus"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:paddingBottom="10dp"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="@id/titleImage"
                app:layout_constraintBottom_toBottomOf="@id/titleImage"
                app:layout_constraintStart_toStartOf="@id/titleImage"
                app:layout_constraintEnd_toEndOf="@id/titleImage" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Daily Bonus Banner Image -->
        <ImageView
            android:id="@+id/bonusBanner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="40dp"
            android:src="@drawable/daily_bonus"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="@id/guide_row_1"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Days Container (Capsule equivalent) -->
        <FrameLayout
            android:id="@+id/daysContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/guide_row_2"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/days_main_bg"
                android:scaleType="fitXY" />

            <!-- Nested Grid for Days -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <!-- Row 1: Days 1-4 -->
                <LinearLayout
                    android:id="@+id/daysRow1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/daysRow2"
                    app:layout_constraintHeight_percent="0.45">

                    <ludoclient.platforms.android.DailyBonusCardView
                        android:id="@+id/D1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp" />
                    <ludoclient.platforms.android.DailyBonusCardView
                        android:id="@+id/D2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp" />
                    <ludoclient.platforms.android.DailyBonusCardView
                        android:id="@+id/D3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp" />
                    <ludoclient.platforms.android.DailyBonusCardView
                        android:id="@+id/D4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp" />
                </LinearLayout>

                <!-- Row 2: Days 5-7 -->
                <LinearLayout
                    android:id="@+id/daysRow2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:weightSum="4"
                    app:layout_constraintTop_toBottomOf="@id/daysRow1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHeight_percent="0.45">

                    <ludoclient.platforms.android.DailyBonusCardView
                        android:id="@+id/D5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp" />
                    <ludoclient.platforms.android.DailyBonusCardView
                        android:id="@+id/D6"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp" />
                    <ludoclient.platforms.android.DailyBonusCardView
                        android:id="@+id/D7"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="2dp" />
                    <!-- Spacer to center 3 items in a weightSum=4 grid -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="invisible" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <!-- Claim Button -->
        <ImageButton
            android:id="@+id/claimBtn"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/btn_claim"
            android:background="@null"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="@id/guide_row_3"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>