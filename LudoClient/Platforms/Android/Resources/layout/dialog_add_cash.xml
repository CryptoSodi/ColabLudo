<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

	<!-- Sandbox Container: 320dp Fixed Width (Gold Standard) -->
	<androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

		<!-- Reference Background -->
		<ImageView
            android:id="@+id/PopupBg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/popup_bg"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:translationY="17dp"
            android:layout_marginBottom="17dp"/>

		<!-- Title Bar -->
		<androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/addCashTitleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:translationY="1dp"
            app:layout_constraintWidth_percent="0.75"
            app:layout_constraintTop_toTopOf="@id/PopupBg"
            app:layout_constraintStart_toStartOf="@id/PopupBg"
            app:layout_constraintEnd_toEndOf="@id/PopupBg">

			<ImageView
                android:id="@+id/titleImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/popup_title"
                android:adjustViewBounds="true" />

			<TextView
                android:translationY="-11dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEPOSIT"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="@id/titleImage"
                app:layout_constraintBottom_toBottomOf="@id/titleImage"
                app:layout_constraintStart_toStartOf="@id/titleImage"
                app:layout_constraintEnd_toEndOf="@id/titleImage" />

		</androidx.constraintlayout.widget.ConstraintLayout>

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="0dp"
			android:layout_height="0dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintWidth_percent="0.95"
            app:layout_constraintTop_toTopOf="@id/PopupBg"
            app:layout_constraintBottom_toBottomOf="@id/PopupBg"
            app:layout_constraintStart_toStartOf="@id/PopupBg"
            app:layout_constraintEnd_toEndOf="@id/PopupBg"
            android:layout_gravity="center">

			<FrameLayout
		        android:layout_width="0dp"
		        android:layout_height="match_parent"
		        android:translationY="5dp"
		        android:layout_marginHorizontal="10dp"
		        app:layout_constraintTop_toTopOf="parent"
		        app:layout_constraintBottom_toBottomOf="parent"
		        app:layout_constraintStart_toStartOf="parent"
		        app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Total Balance HUD -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/balanceBg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/bg_disable_field"
                            android:adjustViewBounds="true"
                            android:scaleType="fitXY"
                            app:layout_constraintTop_toTopOf="parent" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL BALANCE AVAILABLE"
                            android:textSize="10sp"
                            android:textColor="#000000"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toStartOf="@id/balanceBg"
                            app:layout_constraintTop_toTopOf="@id/balanceBg"
                            app:layout_constraintBottom_toBottomOf="@id/balanceBg" />
                        <FrameLayout
                            android:layout_width="100dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintEnd_toEndOf="@id/balanceBg"
                            app:layout_constraintTop_toTopOf="@id/balanceBg"
                            app:layout_constraintBottom_toBottomOf="@id/balanceBg">
                            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_rounded_coins" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="4dp" android:src="@drawable/solicon" />
                            <TextView android:id="@+id/coinsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="0.0" android:textColor="#FFFFFF" android:textSize="12sp" />
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- TAB SYSTEM -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="5dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:weightSum="3"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp">
                            <FrameLayout android:id="@+id/tabQR" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true">
                                <ImageView android:id="@+id/tabQRImg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tab_active" android:scaleType="fitXY"/>
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="QR CODE" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:gravity="center" />
                            </FrameLayout>
                            <FrameLayout android:id="@+id/tabWallet" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true">
                                <ImageView android:id="@+id/tabWalletImg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tab_normal" android:scaleType="fitXY"/>
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="WALLET" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:gravity="center" />
                            </FrameLayout>
                            <FrameLayout android:id="@+id/tabBank" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true">
                                <ImageView android:id="@+id/tabBankImg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tab_normal" android:scaleType="fitXY"/>
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="BANK" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:gravity="center" />
                            </FrameLayout>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <!-- CONTENT: QR CODE -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/contentQR"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_rounded_purple_top">
                            <ImageView
                                android:id="@+id/qrCodeImage"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_margin="20dp"
                                android:background="@drawable/bg_rounded_qr_purple"
                                android:scaleType="fitCenter"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- CONTENT: WALLET -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/contentWallet"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:background="@drawable/bg_rounded_purple_top">
                            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:background="@drawable/bg_rounded_dark_blue_bottom">
                                        <TextView android:id="@+id/transferTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LUDC DEPOSIT PORTAL" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                                        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/transferRow" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" app:layout_constraintTop_toBottomOf="@id/transferTitle">
                                            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/btnWalletTransfer">
                                                <EditText android:id="@+id/walletTransferAmount" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_rounded_edittext" android:hint="Amount" android:textColorHint="#80FFFFFF" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingLeft="10dp" android:paddingRight="40dp" android:inputType="numberDecimal" android:singleLine="true" />
                                                <TextView android:id="@+id/btnDepositMax" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:text="MAX" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" android:clickable="true" android:padding="5dp"/>
                                            </FrameLayout>
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnWalletTransfer" android:layout_width="60dp" android:layout_height="match_parent" android:clickable="true" app:layout_constraintEnd_toEndOf="parent">
                                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY" android:layout_marginLeft="5dp"/>
                                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="SIGN" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp" android:layout_marginLeft="5dp"/>
                                            </androidx.constraintlayout.widget.ConstraintLayout>
                                        </androidx.constraintlayout.widget.ConstraintLayout>
                                    </androidx.constraintlayout.widget.ConstraintLayout>
                                    
                                    <!-- Swap Section (TIGHTENED GAP: 5dp) -->
                                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:padding="8dp" android:background="@drawable/bg_rounded_dark_blue_bottom">
                                        <TextView android:id="@+id/swapTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SWAP TO LUDC" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                                        <LinearLayout android:id="@+id/swapSelectionRow" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/swapTitle">
                                            <Spinner android:id="@+id/swapInputAsset" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_rounded_edittext" android:popupBackground="@drawable/bg_rounded_spinner_popup" />
                                            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="➔" android:textColor="#FFFFFF" android:gravity="center" android:paddingHorizontal="5dp" />
                                            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_rounded_edittext"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="LUDC" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="11sp"/></FrameLayout>
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnSwapPreview" android:layout_width="60dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true">
                                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY"/>
                                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="VIEW" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/>
                                            </androidx.constraintlayout.widget.ConstraintLayout>
                                        </LinearLayout>
                                        <LinearLayout android:id="@+id/swapConfirmRow" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/swapSelectionRow">
                                            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                                                <EditText android:id="@+id/swapInputAmount" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_rounded_edittext" android:hint="Amount" android:textColorHint="#80FFFFFF" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingLeft="10dp" android:paddingRight="40dp" android:inputType="numberDecimal" android:singleLine="true" />
                                                <TextView android:id="@+id/btnSwapMax" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:text="MAX" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" android:clickable="true" android:padding="5dp"/>
                                            </FrameLayout>
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnWalletSwap" android:layout_width="80dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true">
                                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_pink" android:scaleType="fitXY"/>
                                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="CONFIRM" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/>
                                            </androidx.constraintlayout.widget.ConstraintLayout>
                                        </LinearLayout>
                                    </androidx.constraintlayout.widget.ConstraintLayout>
                                </LinearLayout>
                            </ScrollView>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- CONTENT: BANK -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/contentBank"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:background="@drawable/bg_rounded_purple_top">

                            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                                    <!-- MODULE 1: SETUP -->
                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:id="@+id/bankModuleSetup"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:padding="8dp"
                                        android:background="@drawable/bg_rounded_dark_blue_bottom">
                                        <TextView android:id="@+id/setupTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SELECT PAYMENT DESTINATION" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                                        <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/setupTitle">
                                            <Spinner android:id="@+id/manualMethod" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7" android:background="@drawable/bg_rounded_edittext" android:popupBackground="@drawable/bg_rounded_spinner_popup" />
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/selectedAccountBox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:layout_marginLeft="5dp" android:background="@drawable/bg_rounded_edittext" android:padding="4dp"><TextView android:id="@+id/selectedAccountNumber" android:layout_width="match_parent" android:layout_height="match_parent" android:text="SELECT METHOD" android:textColor="#FFFFFF" android:textSize="9.5sp" android:textStyle="bold" android:gravity="center" /></androidx.constraintlayout.widget.ConstraintLayout>
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnBankCopy" android:layout_width="60dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY"/><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="COPY" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/></androidx.constraintlayout.widget.ConstraintLayout>
                                        </LinearLayout>
                                    </androidx.constraintlayout.widget.ConstraintLayout>

                                    <!-- MODULE 2: DEPOSIT PORTAL (TIGHTENED GAP: 5dp) -->
                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:id="@+id/bankModuleForm"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:padding="8dp"
                                        android:background="@drawable/bg_rounded_dark_blue_bottom">
                                        <TextView android:id="@+id/manualTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MANUAL DEPOSIT PORTAL" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                                        <LinearLayout android:id="@+id/manualRow1" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/manualTitle"><EditText android:id="@+id/manualAmount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_rounded_edittext" android:hint="Amount" android:textColorHint="#80FFFFFF" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingLeft="10dp" android:inputType="numberDecimal" android:singleLine="true" /><androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnBankView" android:layout_width="60dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY"/><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="VIEW" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/></androidx.constraintlayout.widget.ConstraintLayout></LinearLayout>
                                        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnPickImage" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:background="@drawable/bg_rounded_edittext" android:clickable="true" app:layout_constraintTop_toBottomOf="@id/manualRow1"><ImageView android:id="@+id/receiptPreview" android:layout_width="25dp" android:layout_height="25dp" android:layout_marginLeft="5dp" android:src="@android:drawable/ic_menu_camera" android:scaleType="centerInside" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/><TextView android:id="@+id/receiptStatus" android:layout_width="0dp" android:layout_height="match_parent" android:text="ATTACH RECEIPT PROOF" android:textColor="#80FFFFFF" android:textSize="9sp" android:gravity="center_vertical" android:layout_marginLeft="8dp" app:layout_constraintStart_toEndOf="@id/receiptPreview" app:layout_constraintEnd_toEndOf="parent"/></androidx.constraintlayout.widget.ConstraintLayout>
                                    </androidx.constraintlayout.widget.ConstraintLayout>

                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PLEASE VERIFY DETAILS BEFORE SUBMITTING" android:textColor="#80FFFFFF" android:textSize="7sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="10dp"/>
                                </LinearLayout>
                            </ScrollView>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </FrameLayout>

                    <!-- Footer Section -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/footerSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rounded_dark_blue_bottom">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/infoAddressCapsule"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="-2dp"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView android:id="@+id/infoAddressBg" android:layout_width="match_parent" android:layout_height="wrap_content" android:src="@drawable/after_add_cash_bg_hor" android:adjustViewBounds="true" android:scaleType="fitXY" app:layout_constraintTop_toTopOf="parent" />
                            <TextView android:id="@+id/infoAddressTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DEPOSIT LUDC TOKEN" android:textColor="#FFFF00" android:textSize="9sp" android:gravity="center" android:layout_marginTop="5dp" app:layout_constraintTop_toTopOf="@id/infoAddressBg" />
                            <TextView android:id="@+id/infoAddressText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ADDRESS" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" android:layout_marginBottom="5dp" app:layout_constraintBottom_toBottomOf="@id/infoAddressBg" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/copyBtn"
                            android:layout_width="100dp"
                            android:layout_height="35dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="10dp"
                            android:clickable="true"
                            app:layout_constraintTop_toBottomOf="@id/infoAddressCapsule"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY" />
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="COPY" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="11sp" android:paddingBottom="4dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnPhantomConnect"
                            android:layout_width="100dp"
                            android:layout_height="35dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="10dp"
                            android:clickable="true"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/infoAddressCapsule"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_verify_account" android:scaleType="fitXY" />
                            <TextView android:id="@+id/phantomBtnText" android:layout_width="match_parent" android:layout_height="match_parent" android:text="CONNECT" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="11sp" android:paddingBottom="4dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnSubmitManual"
                            android:layout_width="100dp"
                            android:layout_height="35dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="10dp"
                            android:clickable="true"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/infoAddressCapsule"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <ImageView android:id="@+id/submitBtnBg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_verify_account" android:scaleType="fitXY" />
                            <TextView android:id="@+id/submitBtnText" android:layout_width="match_parent" android:layout_height="match_parent" android:text="SUBMIT" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="11sp" android:paddingBottom="4dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
			</FrameLayout>
		</androidx.constraintlayout.widget.ConstraintLayout>
	</androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>