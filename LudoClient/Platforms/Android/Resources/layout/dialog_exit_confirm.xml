<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

	<!-- Sandbox Container -->
	<androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

		<!-- Reference Background: signin_inner_bg -->
		<ImageView
            android:id="@+id/PopupBg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/signin_inner_bg"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:translationY="17dp"
            android:layout_marginBottom="17dp"/>

		<!-- Title Bar -->
		<androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/testTitleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:translationY="1dp"
            app:layout_constraintWidth_percent="0.75"
            app:layout_constraintTop_toTopOf="@id/PopupBg"
            app:layout_constraintStart_toStartOf="@id/PopupBg"
            app:layout_constraintEnd_toEndOf="@id/PopupBg">

			<ImageView
                android:id="@+id/titleImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/popup_title"
                android:adjustViewBounds="true" />

			<TextView
                android:translationY="-11dp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="EXIT"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="@id/titleImage"
                app:layout_constraintBottom_toBottomOf="@id/titleImage"
                app:layout_constraintStart_toStartOf="@id/titleImage"
                app:layout_constraintEnd_toEndOf="@id/titleImage" />

		</androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Message Section: Pushed to the center/top -->
        <LinearLayout
            android:id="@+id/messageSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="80dp"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintTop_toTopOf="@id/PopupBg"
            app:layout_constraintStart_toStartOf="@id/PopupBg"
            app:layout_constraintEnd_toEndOf="@id/PopupBg">

            <!-- Inner Blue Box -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#2C40AA"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Are you sure you want to exit?\nYour ranking will be affected!"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:padding="15dp"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Button Section: Anchored to the BOTTOM of the panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="25dp"
            app:layout_constraintBottom_toBottomOf="@id/PopupBg"
            app:layout_constraintStart_toStartOf="@id/PopupBg"
            app:layout_constraintEnd_toEndOf="@id/PopupBg">

            <!-- CANCEL Button -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/cancelBg"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/btn_verify_account"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="CLOSE"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="@id/cancelBg"
                    app:layout_constraintBottom_toBottomOf="@id/cancelBg"
                    app:layout_constraintStart_toStartOf="@id/cancelBg"
                    app:layout_constraintEnd_toEndOf="@id/cancelBg"
                    android:layout_marginBottom="4dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- EXIT Button -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnExit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/exitBg"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/btn_red"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="EXIT"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="@id/exitBg"
                    app:layout_constraintBottom_toBottomOf="@id/exitBg"
                    app:layout_constraintStart_toStartOf="@id/exitBg"
                    app:layout_constraintEnd_toEndOf="@id/exitBg"
                    android:layout_marginBottom="4dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

	</androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>