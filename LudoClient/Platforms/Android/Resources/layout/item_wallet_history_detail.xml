<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

	<FrameLayout
        android:id="@+id/WalletRowSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp">

		<ImageView
			android:id="@+id/WalletRowSummaryBackdrop"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:adjustViewBounds="true"
			android:scaleType="fitXY"
			android:src="@drawable/header_container" />

		<LinearLayout
			android:id="@+id/WalletRowSummaryClickTarget"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clickable="true"
			android:focusable="true"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingLeft="12dp"
			android:paddingRight="10dp">

			<FrameLayout
				android:id="@+id/WalletRowIndexBox"
				android:layout_width="25dp"
				android:layout_height="25dp">

				<ImageView
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:scaleType="fitXY"
					android:src="@drawable/detailgold" />

				<TextView
					android:id="@+id/WalletRowIndex"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center"
					android:textColor="#FFFFFF"
					android:textSize="14sp"
					android:textStyle="bold" />
			</FrameLayout>

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="8dp"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:id="@+id/WalletRowTitle"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="#FFFFFF"
					android:textSize="12sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/WalletRowDate"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="#FFFFFF"
					android:textSize="8sp" />
			</LinearLayout>

			<FrameLayout
				android:layout_width="74dp"
				android:layout_height="wrap_content"
				android:layout_marginEnd="6dp"
				android:foregroundGravity="center">

				<ImageView
					android:id="@+id/WalletRowStatus"
					android:layout_width="match_parent"
					android:layout_height="28dp"
					android:layout_gravity="center"
					android:adjustViewBounds="true"
					android:scaleType="fitCenter"
					android:src="@drawable/pending" />
			</FrameLayout>

			<TextView
				android:id="@+id/WalletRowAmount"
				android:layout_width="54dp"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:textColor="#54DE58"
				android:textSize="10sp"
				android:textStyle="bold" />

			<ImageView
				android:id="@+id/WalletRowArrow"
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:layout_marginStart="4dp"
				android:scaleType="fitCenter"
				android:src="@drawable/arr_down" />

		</LinearLayout>
	</FrameLayout>

	<FrameLayout
		android:id="@+id/WalletRowDetails"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="10dp"
		android:layout_marginEnd="10dp"
		android:layout_marginTop="-5dp"
		android:layout_marginBottom="0dp"
		android:elevation="0dp"
		android:background="@drawable/wallet_history_detail_backdrop"
		android:visibility="gone">

		<LinearLayout
			android:id="@+id/WalletRowDetailCard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingLeft="18dp"
			android:paddingTop="14dp"
			android:paddingRight="18dp"
			android:paddingBottom="14dp">

			<LinearLayout
				android:id="@+id/WalletRowPrimaryDetails"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical" />

			<ImageView
				android:id="@+id/WalletRowDetailDivider"
				android:layout_width="match_parent"
				android:layout_height="2dp"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				android:scaleType="fitXY"
				android:src="@drawable/linehorizontal" />

			<LinearLayout
				android:id="@+id/WalletRowSecondaryDetails"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical" />

		</LinearLayout>

	</FrameLayout>

</LinearLayout>
