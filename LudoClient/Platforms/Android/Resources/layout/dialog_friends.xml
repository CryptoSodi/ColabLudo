<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The main layout centering the whole popup - Using ID for dynamic ratio scaling -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainPopupContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.85"
        app:layout_constraintWidth_max="360dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Background Image -->
        <ImageView
            android:id="@+id/popupBg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/wallet_bg"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:translationY="17dp"
            android:layout_marginBottom="17dp"/>

        <!-- Guidelines (9.1 Grid based) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.12" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.95" />

        <!-- Title Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:translationY="1dp"
            app:layout_constraintWidth_percent="0.75"
            app:layout_constraintTop_toTopOf="@id/popupBg"
            app:layout_constraintStart_toStartOf="@id/popupBg"
            app:layout_constraintEnd_toEndOf="@id/popupBg">
            
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/popup_title"
                android:adjustViewBounds="true" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FRIENDS"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:translationY="-11dp"
                android:letterSpacing="0.1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tabs Section -->
        <LinearLayout
            android:id="@+id/tabsSection"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:translationY="17dp"
            app:layout_constraintTop_toTopOf="@id/guide_row_top"
            app:layout_constraintStart_toStartOf="@id/popupBg"
            app:layout_constraintEnd_toEndOf="@id/popupBg"
            app:layout_constraintWidth_percent="0.6">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tabFriends"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/imgTabFriends"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tab_active"
                    android:scaleType="fitXY" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Friends"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:paddingBottom="2dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tabBlocked"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/imgTabBlocked"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tab_normal"
                    android:scaleType="fitXY" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Blocked"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:paddingBottom="2dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- Header Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerBar"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            android:translationY="17dp"
            app:layout_constraintTop_toBottomOf="@id/tabsSection"
            app:layout_constraintStart_toStartOf="@id/popupBg"
            app:layout_constraintEnd_toEndOf="@id/popupBg">
            
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tab_border"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="10">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:text="RANK"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:gravity="center" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:text="PLAYERS"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="10dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:text="STATUS"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- List Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/listArea"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:layout_marginHorizontal="10dp"
            android:translationY="17dp"
            app:layout_constraintTop_toBottomOf="@id/headerBar"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_bottom"
            app:layout_constraintStart_toStartOf="@id/popupBg"
            app:layout_constraintEnd_toEndOf="@id/popupBg">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:id="@+id/FriendsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@null" />
            </ScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>