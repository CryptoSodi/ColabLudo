<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/PopupBg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/popup_bg"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:translationY="17dp"
            android:layout_marginBottom="17dp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/withdrawTitleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:translationY="1dp"
            app:layout_constraintWidth_percent="0.75"
            app:layout_constraintTop_toTopOf="@id/PopupBg"
            app:layout_constraintStart_toStartOf="@id/PopupBg"
            app:layout_constraintEnd_toEndOf="@id/PopupBg">
            <ImageView
                android:id="@+id/titleImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/popup_title"
                android:adjustViewBounds="true" />
            <TextView
                android:translationY="-11dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WITHDRAW"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="@id/titleImage"
                app:layout_constraintBottom_toBottomOf="@id/titleImage"
                app:layout_constraintStart_toStartOf="@id/titleImage"
                app:layout_constraintEnd_toEndOf="@id/titleImage" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintWidth_percent="0.95"
            app:layout_constraintTop_toTopOf="@id/PopupBg"
            app:layout_constraintBottom_toBottomOf="@id/PopupBg"
            app:layout_constraintStart_toStartOf="@id/PopupBg"
            app:layout_constraintEnd_toEndOf="@id/PopupBg">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationY="5dp"
                android:layout_marginHorizontal="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Balance HUD -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/balanceBg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/bg_disable_field"
                            android:adjustViewBounds="true"
                            android:scaleType="fitXY"
                            app:layout_constraintTop_toTopOf="parent" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL BALANCE AVAILABLE"
                            android:textSize="10sp"
                            android:textColor="#000000"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toStartOf="@id/balanceBg"
                            app:layout_constraintTop_toTopOf="@id/balanceBg"
                            app:layout_constraintBottom_toBottomOf="@id/balanceBg" />
                        <FrameLayout
                            android:layout_width="100dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintEnd_toEndOf="@id/balanceBg"
                            app:layout_constraintTop_toTopOf="@id/balanceBg"
                            app:layout_constraintBottom_toBottomOf="@id/balanceBg">
                            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_rounded_coins" />
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="4dp" android:src="@drawable/solicon" />
                            <TextView android:id="@+id/coinsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="0.0" android:textColor="#FFFFFF" android:textSize="12sp" />
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- TAB SYSTEM -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="5dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:weightSum="3"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp">
                            <FrameLayout android:id="@+id/tabSOL" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true">
                                <ImageView android:id="@+id/tabSOLImg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tab_active" android:scaleType="fitXY"/>
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="SOLANA" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:gravity="center" />
                            </FrameLayout>
                            <FrameLayout android:id="@+id/tabWallet" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true">
                                <ImageView android:id="@+id/tabWalletImg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tab_normal" android:scaleType="fitXY"/>
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="WALLET" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:gravity="center" />
                            </FrameLayout>
                            <FrameLayout android:id="@+id/tabBank" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true">
                                <ImageView android:id="@+id/tabBankImg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tab_normal" android:scaleType="fitXY"/>
                                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="BANK" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:gravity="center" />
                            </FrameLayout>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <!-- CONTENT: SOLANA -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/contentSOL"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_rounded_purple_top">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DESTINATION ADDRESS" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" android:layout_marginBottom="5dp"/>
                                <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:orientation="horizontal">
                                    <EditText android:id="@+id/addressEntry" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_rounded_edittext" android:textColor="#FFFFFF" android:textSize="10sp" android:paddingLeft="10dp" android:singleLine="true" android:hint="Paste External Address" android:textColorHint="#80FFFFFF"/>
                                    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnPaste" android:layout_width="60dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true">
                                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY"/>
                                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="PASTE" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/>
                                    </androidx.constraintlayout.widget.ConstraintLayout>
                                </LinearLayout>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LUDC AMOUNT" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_marginBottom="5dp"/>
                                <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:orientation="horizontal">
                                    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                                        <EditText android:id="@+id/amountEntry" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_rounded_edittext" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingLeft="10dp" android:paddingRight="40dp" android:inputType="numberDecimal" android:singleLine="true" android:hint="0.00"/>
                                        <TextView android:id="@+id/btnWithdrawMax" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:text="MAX" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" android:clickable="true" android:padding="5dp"/>
                                    </FrameLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- CONTENT: WALLET -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/contentWallet"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:background="@drawable/bg_rounded_purple_top">
                            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:background="@drawable/bg_rounded_dark_blue_bottom">
                                        <TextView android:id="@+id/walletWithdrawTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PHANTOM PAYOUT HUB" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                                        <LinearLayout android:id="@+id/walletWithdrawRow" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/walletWithdrawTitle">
                                            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                                                <EditText android:id="@+id/walletAmountEntry" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_rounded_edittext" android:hint="LUDC Amount" android:textColorHint="#80FFFFFF" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingLeft="10dp" android:paddingRight="40dp" android:inputType="numberDecimal" android:singleLine="true" />
                                                <TextView android:id="@+id/btnWalletMax" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:text="MAX" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" android:clickable="true" android:padding="5dp"/>
                                            </FrameLayout>
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnWalletSign" android:layout_width="60dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY"/><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="SIGN" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/></androidx.constraintlayout.widget.ConstraintLayout>
                                        </LinearLayout>
                                    </androidx.constraintlayout.widget.ConstraintLayout>
                                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="8dp" android:background="@drawable/bg_rounded_dark_blue_bottom">
                                        <TextView android:id="@+id/walletSwapTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LUDC TO USDC SWAP" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                                        <LinearLayout android:id="@+id/walletSwapRow1" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/walletSwapTitle">
                                            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_rounded_edittext"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="LUDC" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="11sp"/></FrameLayout>
                                            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="➔" android:textColor="#FFFFFF" android:gravity="center" android:paddingHorizontal="5dp" />
                                            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_rounded_edittext"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="USDC" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="11sp"/></FrameLayout>
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnWalletSwapView" android:layout_width="60dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY"/><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="VIEW" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/></androidx.constraintlayout.widget.ConstraintLayout>
                                        </LinearLayout>
                                        <LinearLayout android:id="@+id/walletSwapRow2" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/walletSwapRow1">
                                            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                                                <EditText android:id="@+id/walletSwapAmount" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_rounded_edittext" android:hint="Amount" android:textColorHint="#80FFFFFF" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingLeft="10dp" android:paddingRight="40dp" android:inputType="numberDecimal" android:singleLine="true" />
                                                <TextView android:id="@+id/btnSwapMax" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:text="MAX" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" android:clickable="true" android:padding="5dp"/>
                                            </FrameLayout>
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnWalletSwapConfirm" android:layout_width="80dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_pink" android:scaleType="fitXY"/><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="CONFIRM" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/></androidx.constraintlayout.widget.ConstraintLayout>
                                        </LinearLayout>
                                    </androidx.constraintlayout.widget.ConstraintLayout>
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WITHDRAWAL WILL BE SENT TO CONNECTED WALLET" android:textColor="#80FFFFFF" android:textSize="7sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="15dp"/>
                                </LinearLayout>
                            </ScrollView>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- CONTENT: BANK -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/contentBank"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:background="@drawable/bg_rounded_purple_top">
                            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                                    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/bankModuleSetup" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:background="@drawable/bg_rounded_dark_blue_bottom">
                                        <TextView android:id="@+id/setupTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SELECT PAYMENT DESTINATION" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                                        <LinearLayout android:id="@+id/setupRow" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/setupTitle">
                                            <Spinner android:id="@+id/manualMethod" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7" android:background="@drawable/bg_rounded_edittext" android:popupBackground="@drawable/bg_rounded_spinner_popup" />
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/selectedAccountBox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:layout_marginLeft="5dp" android:background="@drawable/bg_rounded_edittext" android:padding="4dp"><TextView android:id="@+id/selectedAccountNumber" android:layout_width="match_parent" android:layout_height="match_parent" android:text="SELECT METHOD" android:textColor="#FFFFFF" android:textSize="9.5sp" android:textStyle="bold" android:gravity="center" /></androidx.constraintlayout.widget.ConstraintLayout>
                                            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnBankCopy" android:layout_width="60dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY"/><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="COPY" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/></androidx.constraintlayout.widget.ConstraintLayout>
                                        </LinearLayout>
                                    </androidx.constraintlayout.widget.ConstraintLayout>
                                    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/bankModuleForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="8dp" android:background="@drawable/bg_rounded_dark_blue_bottom">
                                        <TextView android:id="@+id/manualTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MANUAL PAYOUT PORTAL" android:textColor="#FFFF00" android:textSize="9sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                                        <LinearLayout android:id="@+id/manualRow1" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/manualTitle"><EditText android:id="@+id/manualAmount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_rounded_edittext" android:hint="Amount" android:textColorHint="#80FFFFFF" android:textColor="#FFFFFF" android:textSize="11sp" android:paddingLeft="10dp" android:inputType="numberDecimal" android:singleLine="true" /><androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnBankView" android:layout_width="60dp" android:layout_height="match_parent" android:layout_marginLeft="5dp" android:clickable="true"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY"/><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="VIEW" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="9sp" android:paddingBottom="2dp"/></androidx.constraintlayout.widget.ConstraintLayout></LinearLayout>
                                        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnPickImage" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="5dp" android:background="@drawable/bg_rounded_edittext" android:clickable="true" app:layout_constraintTop_toBottomOf="@id/manualRow1"><ImageView android:id="@+id/receiptPreview" android:layout_width="25dp" android:layout_height="25dp" android:layout_marginLeft="5dp" android:src="@android:drawable/ic_menu_camera" android:scaleType="centerInside" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/><TextView android:id="@+id/receiptStatus" android:layout_width="0dp" android:layout_height="match_parent" android:text="ATTACH RECEIPT PROOF" android:textColor="#80FFFFFF" android:textSize="9sp" android:gravity="center_vertical" android:layout_marginLeft="8dp" app:layout_constraintStart_toEndOf="@id/receiptPreview" app:layout_constraintEnd_toEndOf="parent"/></androidx.constraintlayout.widget.ConstraintLayout>
                                    </androidx.constraintlayout.widget.ConstraintLayout>
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PLEASE VERIFY DETAILS BEFORE SUBMITTING" android:textColor="#80FFFFFF" android:textSize="7sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="10dp"/>
                                </LinearLayout>
                            </ScrollView>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </FrameLayout>

                    <!-- Footer Section -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/footerSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rounded_dark_blue_bottom">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/infoFooterCapsule"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="-2dp"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView android:id="@+id/footerBg" android:layout_width="match_parent" android:layout_height="wrap_content" android:src="@drawable/after_add_cash_bg_hor" android:adjustViewBounds="true" android:scaleType="fitXY" app:layout_constraintTop_toTopOf="parent" />
                            <TextView android:id="@+id/footerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WITHDRAW LUDC TOKEN" android:textColor="#FFFF00" android:textSize="9sp" android:gravity="center" android:layout_marginTop="5dp" app:layout_constraintTop_toTopOf="@id/footerBg" />
                            <TextView android:id="@+id/footerText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXTERNAL ADDRESS" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" android:layout_marginBottom="5dp" app:layout_constraintBottom_toBottomOf="@id/footerBg" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/copyBtn"
                            android:layout_width="100dp"
                            android:layout_height="35dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="10dp"
                            android:clickable="true"
                            app:layout_constraintTop_toBottomOf="@id/infoFooterCapsule"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_orange" android:scaleType="fitXY" />
                            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="COPY" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="11sp" android:paddingBottom="4dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnPhantomConnect"
                            android:layout_width="100dp"
                            android:layout_height="35dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="10dp"
                            android:clickable="true"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/infoFooterCapsule"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_verify_account" android:scaleType="fitXY" />
                            <TextView android:id="@+id/phantomBtnText" android:layout_width="match_parent" android:layout_height="match_parent" android:text="CONNECT" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="11sp" android:paddingBottom="4dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnSubmitManual"
                            android:layout_width="100dp"
                            android:layout_height="35dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="10dp"
                            android:clickable="true"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/infoFooterCapsule"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <ImageView android:id="@+id/submitBtnBg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/btn_verify_account" android:scaleType="fitXY" />
                            <TextView android:id="@+id/submitBtnText" android:layout_width="match_parent" android:layout_height="match_parent" android:text="SUBMIT" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold" android:textSize="11sp" android:paddingBottom="4dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>