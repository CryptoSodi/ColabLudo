<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The root container centered on screen -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <!-- This image defines the aspect ratio and boundaries -->
        <ImageView
            android:id="@+id/popupBg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/dailybonus_popup_bg"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Guidelines based on the 9.1 star Grid RowDefinitions -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.0879" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.1098" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.6593" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.7912" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.9011" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.9670" />

        <!-- Title Bar: 2/3 width, centered, with negative margin -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintWidth_percent="0.66"
            app:layout_constraintTop_toTopOf="@id/popupBg"
            app:layout_constraintStart_toStartOf="@id/popupBg"
            app:layout_constraintEnd_toEndOf="@id/popupBg"
            android:translationY="-18dp">
            
            <ImageView
                android:id="@+id/titleImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/popup_title"
                android:adjustViewBounds="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
                
            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="SETTINGS"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:paddingBottom="10dp"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="@id/titleImage"
                app:layout_constraintBottom_toBottomOf="@id/titleImage"
                app:layout_constraintStart_toStartOf="@id/titleImage"
                app:layout_constraintEnd_toEndOf="@id/titleImage" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Container for Settings Switches -->
        <FrameLayout
            android:id="@+id/settingsContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toTopOf="@id/guide_row_1"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_2"
            app:layout_constraintStart_toStartOf="@id/popupBg"
            app:layout_constraintEnd_toEndOf="@id/popupBg">
            
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/settings_forground"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:paddingHorizontal="16dp">

                <ludoclient.platforms.android.SettingsSwitchView
                    android:id="@+id/soundSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ludoclient.platforms.android.SettingsSwitchView
                    android:id="@+id/vibrationSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ludoclient.platforms.android.SettingsSwitchView
                    android:id="@+id/notificationSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </FrameLayout>

        <!-- Help Button -->
        <ImageButton
            android:id="@+id/settingsBtnHelp"
            android:layout_width="48dp"
            android:layout_height="0dp"
            android:src="@drawable/help"
            android:background="@null"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/guide_row_2"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- SIGN OUT Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnSignOut"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/guide_row_3"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_4"
            app:layout_constraintStart_toStartOf="@id/popupBg"
            app:layout_constraintEnd_toEndOf="@id/popupBg">
            
            <ImageView
                android:id="@+id/signOutBg"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/btn_exit"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
                
            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="SIGN OUT"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/signOutBg"
                app:layout_constraintBottom_toBottomOf="@id/signOutBg"
                app:layout_constraintStart_toStartOf="@id/signOutBg"
                app:layout_constraintEnd_toEndOf="@id/signOutBg" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Version Text -->
        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:textColor="#FFFFFF"
            android:text="Version : "
            android:gravity="center"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="@id/guide_row_4"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_5"
            app:layout_constraintStart_toStartOf="@id/popupBg"
            app:layout_constraintEnd_toEndOf="@id/popupBg" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>