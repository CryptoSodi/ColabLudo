<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The main layout with fixed size matching MAUI HeightRequest="455" WidthRequest="320" -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="320dp"
        android:layout_height="455dp"
        android:layout_gravity="center">

        <!-- Background Image - Set to Fill matching MAUI Aspect="Fill" -->
        <ImageView
            android:id="@+id/popupBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/dailybonus_popup_bg"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Proportion Guidelines based on total 9.1 stars from original Grid RowDefinitions -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.0879" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.1098" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.6593" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.7912" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.9011" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_row_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.9670" />

        <!-- Title Bar - Fixed width 2/3 of 320dp = approx 213dp -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleBar"
            android:layout_width="253dp"
            android:layout_height="wrap_content"
            android:translationY="-14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <ImageView
                android:id="@+id/titleImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/popup_title"
                android:adjustViewBounds="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
                
            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="SETTINGS"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="@id/titleImage"
                app:layout_constraintBottom_toBottomOf="@id/titleImage"
                app:layout_constraintStart_toStartOf="@id/titleImage"
                app:layout_constraintEnd_toEndOf="@id/titleImage" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Container for Settings Switches - Margin 24dp matches MAUI -->
        <FrameLayout
            android:id="@+id/settingsContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toTopOf="@id/guide_row_1"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/settings_forground"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <ludoclient.platforms.android.SettingsSwitchView
                    android:id="@+id/soundSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ludoclient.platforms.android.SettingsSwitchView
                    android:id="@+id/vibrationSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ludoclient.platforms.android.SettingsSwitchView
                    android:id="@+id/notificationSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </FrameLayout>

        <!-- Hidden Grid for Links -->
        <LinearLayout
            android:id="@+id/linksContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/guide_row_2"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <ImageButton
                android:id="@+id/settingsBtnHelp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/help"
                android:background="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- SIGN OUT Button -->
        <FrameLayout
            android:id="@+id/btnSignOut"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/guide_row_3"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            
            <ImageView
                android:id="@+id/signOutBg"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/btn_exit"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="SIGN OUT"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Version Text -->
        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:textColor="#FFFFFF"
            android:text="Version : "
            android:gravity="center"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="@id/guide_row_4"
            app:layout_constraintBottom_toBottomOf="@id/guide_row_5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>