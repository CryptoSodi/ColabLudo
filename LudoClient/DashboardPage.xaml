<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LudoClient.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LudoClient"
    xmlns:constants="clr-namespace:LudoClient.Constants"
    xmlns:extensions="clr-namespace:LudoClient.Extensions"
    BackgroundImageSource="{x:Static constants:Skins.Background}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowSpacing="20" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowDefinitions=".8*,1*,1*,1*,1*,1*,.8*">


        <Image Grid.Row="1" Margin="40,20,40,20" Grid.RowSpan="2" Source="logo.webp" VerticalOptions="Center" HorizontalOptions="Center"/>

        <Image Grid.Row="1" Source="ic_settings.webp" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start" VerticalOptions="Start" Margin="10">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="TestUi_Clicked" />
            </Image.GestureRecognizers>
        </Image>


        <Image x:Name="CashImage" Grid.Row="3" Source="{x:Static constants:Skins.Cash}" VerticalOptions="Center" HorizontalOptions="Center">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="CashGame_Clicked" />
            </Image.GestureRecognizers>
        </Image>

        <Grid Grid.Row="4" Margin="40,0,40,0" HorizontalOptions="Fill" VerticalOptions="Center" ColumnDefinitions="50*,50*">

            <Image x:Name="TournamentImage" Grid.Column="1" Source="{x:Static constants:Skins.Tournament}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Tournament_Clicked" />
                </Image.GestureRecognizers>
            </Image>
            <Image x:Name="PlayWithFriendsImage" Source="{x:Static constants:Skins.Play}" Margin="0,0,0,4">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="PlayWithFriend_Clicked" />
                </Image.GestureRecognizers>
            </Image>
        </Grid>
        <Image x:Name="DailyBonusImage" Source="{x:Static constants:Skins.DailyBonus}" Grid.Row="5" Margin="75,0,75,0" VerticalOptions="Center" HorizontalOptions="Center">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="Bonus_Clicked" />
            </Image.GestureRecognizers>
        </Image>
    </Grid>
</ContentPage>