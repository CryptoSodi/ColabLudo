<?xml version="1.0" encoding="utf-8" ?>
<popup:BasePopup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:constants="clr-namespace:SharedCode.Constants"
           xmlns:local="clr-namespace:LudoClient.ControlView"
           xmlns:popup="clr-namespace:LudoClient.Popups"
           x:Class="LudoClient.Popups.AddCash"
           ImageSource="popup_bg.webp">
    <popup:BasePopup.PopupContent>
        <Grid RowSpacing="20" VerticalOptions="Fill" HorizontalOptions="Fill" RowDefinitions=".5*,8*,.5*" ColumnDefinitions=".4*,8*,.4*">
            <local:TitleBar Grid.Row="1" Grid.Column="1" Title="DEPOSIT" Margin="20,-58,20,0" HorizontalOptions="Fill" VerticalOptions="Start"/>            
            <StackLayout Spacing="5" Grid.Row="1" Grid.Column="1" Margin="10,0,10,0" VerticalOptions="Fill" HorizontalOptions="Fill" >
                <local:Capsule ImageSource="bg_disable_field.webp" VerticalOptions="Start" HorizontalOptions="Fill">
                    <Grid Margin="0,5,8,8.5" ColumnDefinitions="Auto,1*">
                        <Label Text="TOTAL BALANCE AVAILABLE" FontSize="12" Margin="10,0,5,0" TextColor="Black" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" VerticalOptions="Center"/>
                        <Grid Grid.Column="1" HorizontalOptions="Fill" VerticalOptions="Fill">
                            <Frame BackgroundColor="#60000000" CornerRadius="4" Padding="30,-5,30,-5" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                            <Image Source="solicon.webp" Margin="4" VerticalOptions="Center" HorizontalOptions="Start"/>
                            <Label x:Name="Coins" Text="0.0" Margin="4,0,0,0" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>
                    </Grid>
                </local:Capsule>
                <!-- TABS SECTION (FriendsPage Style) -->
                <Grid HorizontalOptions="Fill" Margin="0,0,0,-5"  VerticalOptions="Start" RowDefinitions="Auto,Auto" ColumnDefinitions="1*,5*,1*">
                    <Grid Grid.Column="1" HorizontalOptions="Fill" VerticalOptions="End" ColumnDefinitions=".1*,.1*,.1*">
                        <local:ImageSwitch x:Name="Tab1" SwitchText="QR-CODE" SwitchState="False" SwitchOn="tab_normal.webp" SwitchOff="tab_active.webp" VerticalOptions="End" HorizontalOptions="Fill" RequestActivate="TabRequestedActivate" IsIndependent="False"/>
                        <local:ImageSwitch x:Name="Tab2" Grid.Column="1" SwitchText="WALLET" SwitchState="True" SwitchOn="tab_normal.webp" SwitchOff="tab_active.webp" VerticalOptions="End" HorizontalOptions="Fill" RequestActivate="TabRequestedActivate" IsIndependent="False"/>
                        <local:ImageSwitch x:Name="Tab3" Grid.Column="3" SwitchText="BANK" SwitchState="True" SwitchOn="tab_normal.webp" SwitchOff="tab_active.webp" VerticalOptions="End" HorizontalOptions="Fill" RequestActivate="TabRequestedActivate" IsIndependent="False"/>
                    </Grid>
                </Grid>

                <!-- ON-CHAIN CONTENT (DEFAULT) -->
                <Grid x:Name="ContentOnChain" Margin="2,0,2,10" VerticalOptions="Start" HorizontalOptions="Fill">
                    <BoxView CornerRadius="10,10,0,0" BackgroundColor="#A92C40AA" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <StackLayout Spacing="10" Margin="2,15,2,20" VerticalOptions="Fill" HorizontalOptions="Fill">
                        <Image x:Name="QRCodeImage" WidthRequest="140" HeightRequest="140" Aspect="AspectFit" BackgroundColor="#4031af"/>
                        <local:Capsule ImageSource="after_add_cash_bg_hor.webp" Margin="-2,0,-2,0" HorizontalOptions="Fill" VerticalOptions="Fill">
                            <Grid Margin="5" HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Label Text="DEPOSIT LUDC TOKEN" TextColor="Yellow" FontSize="9" HorizontalTextAlignment="Center" VerticalTextAlignment="Start"/>
                                <Label x:Name="AddressText" Text="ADDRESS" TextColor="White" FontSize="9" HorizontalTextAlignment="Center" VerticalTextAlignment="End"/>
                            </Grid>
                        </local:Capsule>
                    </StackLayout>
                </Grid>

                <!-- LOCAL WALLET CONTENT (HIDDEN BY DEFAULT) -->
                <Grid x:Name="ContentLocal" IsVisible="False" Margin="2,0,2,10" VerticalOptions="FillAndExpand" HorizontalOptions="Fill">
                    <BoxView CornerRadius="10,10,0,0" BackgroundColor="#A92C40AA" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <StackLayout Spacing="15" Margin="10,30,10,30" VerticalOptions="Center" HorizontalOptions="Fill">
                        <Label Text="LOCAL WALLET MODULE" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label Text="Placeholder for local payment info..." TextColor="Silver" FontSize="12" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Grid>

                <!-- BANK CONTENT (HIDDEN BY DEFAULT) -->
                <Grid x:Name="ContentBank" IsVisible="False" Margin="2,0,2,10" VerticalOptions="FillAndExpand" HorizontalOptions="Fill">
                    <BoxView CornerRadius="10,10,0,0" BackgroundColor="#A92C40AA" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <StackLayout Spacing="15" Margin="10,30,10,30" VerticalOptions="Center" HorizontalOptions="Fill">
                        <Label Text="BANK TRANSFER MODULE" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label Text="Placeholder for bank details..." TextColor="Silver" FontSize="12" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Grid>

                <!-- SHARED FOOTER (COPY BUTTON) -->
                <Grid x:Name="SharedFooter" Margin="2,-20,2,10" ColumnSpacing="15" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnDefinitions="1*,1*,1*">
                    <BoxView Grid.ColumnSpan="3" CornerRadius="0,0,10,10" BackgroundColor="#24348A" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <local:Capsule Grid.Column="1" HeightRequest="40" ImageSource="btn_orange.webp" HorizontalOptions="Fill" VerticalOptions="End">
                        <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCopyButtonClicked" />
                            </Grid.GestureRecognizers>
                            <Label Text="COPY" TextColor="White" FontSize="12" Margin="0,0,0,4" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Grid>
                    </local:Capsule>
                </Grid>
            </StackLayout>
        </Grid>
    </popup:BasePopup.PopupContent>
</popup:BasePopup>